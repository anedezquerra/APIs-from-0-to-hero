\@writefile{lof}{\contentsline {figure}{\numberline {15.1}{\ignorespaces Token bucket mechanics. Left: refill at $r$ tokens/s into a bucket capped at $B$; admission consumes one token, empty buckets reject. Right: token level over time --- a full bucket absorbs a burst of $B$ instantly (vertical drop), refills linearly at $r$, then admits only as fast as tokens drip in. The area discipline of Proposition~\ref {prop:ch14-tb-envelope} is visible: burst height $B$, sustained slope $r$.}}{910}{figure.15.1}\protected@file@percent }
\newlabel{fig:ch14-token-bucket}{{15.1}{910}{Token bucket mechanics. Left: refill at $r$ tokens/s into a bucket capped at $B$; admission consumes one token, empty buckets reject. Right: token level over time --- a full bucket absorbs a burst of $B$ instantly (vertical drop), refills linearly at $r$, then admits only as fast as tokens drip in. The area discipline of Proposition~\ref {prop:ch14-tb-envelope} is visible: burst height $B$, sustained slope $r$}{figure.15.1}{}}
